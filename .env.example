# ==================================================
# UCP Merchant Server - Environment Variables
# ==================================================
# Copy this to .env and fill in your values

MERCHANT_NAME=TechVault Electronics
ENVIRONMENT=development

# --- Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=ucp-merchant-server

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- API security ---
# Key for merchant-admin endpoints (orders management, webhooks, key listing),
# sent as the X-API-Key header. Leave empty to keep those endpoints disabled.
ADMIN_API_KEY=
# Comma-separated browser origins allowed cross-origin. Empty = none.
CORS_ALLOW_ORIGINS=
# Local demos only: allow http / private-network webhook URLs.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Local debugging only: include exception text in 500 responses.
EXPOSE_ERROR_DETAILS=false
